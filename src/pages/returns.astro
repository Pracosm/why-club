---
import SectionHeader from "@/components/storefront/SectionHeader.astro";
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";
import { returnsPolicy } from "@/lib/demo-data";
---

<StorefrontLayout title="WhÿClub | Returns & Exchange">
  <div class="redesign-root bg-[#F9F9F9] min-h-screen pt-12 pb-24">
    <section class="mx-auto max-w-7xl px-6">
      <header class="mb-16 border-b border-black/5 pb-12 text-center">
        <p class="text-[0.65rem] font-bold uppercase tracking-[0.3em] text-black/40 mb-4">Policies</p>
        <h1 class="heading-condensed text-5xl font-black uppercase tracking-tight text-black md:text-7xl">
          Returns & Exchange.
        </h1>
        <p class="font-editorial mt-6 text-sm font-medium text-black/50 max-w-2xl mx-auto">
          Fast policy, clear terms, no support theatre. Built to ensure your experience stays seamless.
        </p>
      </header>

      <div class="grid gap-6 md:grid-cols-2">
        {returnsPolicy.map((item) => (
          <article class="rounded-[2rem] bg-white p-10 border border-black/5 shadow-sm">
            <h2 class="heading-condensed text-3xl font-black text-black mb-4 uppercase">{item.title}</h2>
            <p class="font-editorial text-sm leading-relaxed text-black/60">{item.body}</p>
          </article>
        ))}

        <article class="rounded-[2rem] bg-black p-10 text-white shadow-xl shadow-black/10">
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.3em] text-red-400 mb-4">Exchange Policy</p>
          <p class="font-editorial text-sm leading-relaxed text-white/60">
            Size exchanges stay free and depend on stock availability. If the requested size is sold out, the operational fallback is a refund or a manual support resolution through the admin workflow.
          </p>
        </article>

        <article class="rounded-[2rem] bg-white p-10 border border-black/5 shadow-sm">
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.3em] text-black/40 mb-4">What to Report Fast</p>
          <p class="font-editorial text-sm leading-relaxed text-black/60">
            Damaged or defective items must be reported within 48 hours with photo proof. This page mirrors the support logic that later plugs into ticketing or admin notes.
          </p>
        </article>
      </div>
    </section>
  </div>
</StorefrontLayout>
