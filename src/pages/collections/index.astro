---
import ProductCard from "@/components/storefront/ProductCard.astro";
import SectionHeader from "@/components/storefront/SectionHeader.astro";
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";
import { demoCollections, demoProducts, getProductsByCollection } from "@/lib/demo-data";
---

<StorefrontLayout
  title="WhÿClub | collections"
  description="Browse the current WhyClub drop and the full oversized tee lineup."
>
  <div class="redesign-root bg-[#F9F9F9] min-h-screen pb-20">
    <header class="pt-24 pb-12 px-6 max-w-7xl mx-auto text-center">
      <h1 class="heading-condensed text-5xl md:text-7xl font-black text-black mb-4">The Collections</h1>
      <p class="font-editorial text-sm text-black/60 max-w-2xl mx-auto">
        Built like drops, not an endless feed. The assortment stays narrow on purpose so each product still feels like a release instead of inventory wallpaper.
      </p>
    </header>

    <section class="mx-auto max-w-7xl px-5 md:px-6">
      <div class="grid gap-8">
        {
          demoCollections.map((collection) => (
            <article class="group overflow-hidden rounded-[2rem] bg-white border border-black/5 shadow-sm smooth-transition hover:shadow-xl">
              <div class="grid md:grid-cols-[1.2fr_0.8fr] lg:grid-cols-[1fr_1fr]">
                <div class="relative w-full aspect-[4/3] md:aspect-auto md:h-full bg-[#F5F5F5] overflow-hidden">
                  <img src={collection.imageUrl} alt={collection.title} class="h-full w-full object-cover object-top smooth-transition group-hover:scale-105" />
                  <div class="absolute top-4 left-4 bg-white/80 backdrop-blur-sm rounded px-2.5 py-1 text-[0.6rem] font-bold uppercase tracking-widest text-black">
                    Live Now
                  </div>
                </div>
                <div class="flex flex-col justify-center p-8 md:p-12 lg:p-16">
                  <div>
                    <h2 class="heading-condensed text-4xl md:text-5xl font-black text-black mb-4">{collection.title}</h2>
                    <p class="font-editorial text-sm leading-relaxed text-black/60 mb-8">{collection.description}</p>
                  </div>
                  <div class="flex items-center justify-between mt-auto pt-8 border-t border-black/5">
                    <span class="text-[0.65rem] font-bold uppercase tracking-widest text-black/40">
                      {getProductsByCollection(collection.slug).length} Styles
                    </span>
                    <a href={`/collections/${collection.slug}`} class="flex h-12 items-center justify-center rounded-full bg-black px-6 text-[0.65rem] font-bold uppercase tracking-widest text-white transition-transform active:scale-95 premium-shadow">
                      Explore Drop <span class="ml-2 font-normal">→</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 md:px-6 pt-24">
      <div class="flex items-end justify-between mb-8 border-b border-black/5 pb-4">
        <h2 class="font-editorial text-sm font-bold uppercase tracking-widest text-black">All Styles</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {demoProducts.map((product) => (
          <div class="bg-white rounded-[1.5rem] p-3 border border-black/5 shadow-sm">
            <ProductCard product={product} />
          </div>
        ))}
      </div>
    </section>
  </div>
</StorefrontLayout>
