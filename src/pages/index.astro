---
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";
import DesktopHome from "@/components/storefront/desktop/DesktopHome.astro";
import MobileHome from "@/components/storefront/mobile/MobileHome.astro";
import { demoProducts, siteCopy } from "@/lib/demo-data";

const heroProduct = demoProducts.find((product) => product.slug === "please-im-a-star") ?? demoProducts[0];
const starGaze = demoProducts.find((product) => product.slug === "star-gaze") ?? heroProduct;
const midnight = demoProducts.find((product) => product.slug === "midnight-in-mumbai") ?? demoProducts[0];

const categories = [
  { label: "Tees", image: midnight.images[0], href: "/collections/drop-01" },
  { label: "Hoodies", image: starGaze.images[0], href: "/collections" },
  { label: "Bottoms", image: heroProduct.images[0], href: "/collections" },
  { label: "Accessories", image: starGaze.images[0], href: "/collections" },
];

const trustItems = [
  { icon: "◇", title: "Premium Quality", body: "100% Cotton" },
  { icon: "▱", title: "Cash On Delivery", body: "Pan India" },
  { icon: "↻", title: "Easy Returns", body: "7 Day Policy" },
  { icon: "▢", title: "Secure Payments", body: "UPI & Cards" },
];
---

<StorefrontLayout
  title="WhÿClub | bold oversized streetwear"
  description={siteCopy.heroBody}
>
  <div class="hidden lg:block">
    <DesktopHome
      heroProduct={heroProduct}
      categories={categories}
      trustItems={trustItems}
      products={demoProducts}
    />
  </div>
  <div class="block lg:hidden">
    <MobileHome
      heroProduct={heroProduct}
      categories={categories}
      trustItems={trustItems}
      products={demoProducts}
    />
  </div>
</StorefrontLayout>
