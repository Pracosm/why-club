---
import CategoryCard from "../CategoryCard.astro";
import TrustBadge from "../TrustBadge.astro";
import ProductCard from "../ProductCard.astro";
import { formatInr } from "@/lib/utils";
import type { demoProducts } from "@/lib/demo-data";

interface Props {
  heroProduct: typeof demoProducts[0];
  categories: Array<{ label: string; image: string; href: string }>;
  trustItems: Array<{ icon: string; title: string; body: string }>;
  products: typeof demoProducts;
}

const { heroProduct, categories, trustItems, products } = Astro.props;
---

<div class="redesign-root flex flex-col pb-24 bg-[#F9F9F9]">
  <!-- Desktop Hero Section -->
  <section class="mx-auto flex max-w-7xl flex-row items-center gap-12 px-6 py-12 xl:gap-24">
    <!-- Left Copy -->
    <article class="flex flex-1 flex-col justify-center">
      <div class="mb-6 flex items-center gap-3">
        <span class="rounded-md bg-[#DFFF3F] px-3 py-1 text-xs font-bold uppercase tracking-widest text-black">
          New Drop
        </span>
      </div>

      <h1 class="heading-condensed text-7xl font-black leading-[0.85] text-black xl:text-[8rem]">
        PLEASE<br />I'M A STAR
      </h1>

      <p class="font-editorial mt-6 max-w-md text-base font-semibold leading-relaxed text-black/70">
        Bold graphics. Oversized fits.
      </p>

      <div class="mt-8 flex items-end gap-4 border-b border-black/10 pb-8">
        <strong class="text-3xl font-black text-black">{formatInr(heroProduct.sellingPrice)}</strong>
        <span class="text-sm font-medium text-black/40 line-through mb-1">{formatInr(heroProduct.mrp)}</span>
      </div>

      <div class="mt-8 flex items-center gap-6">
        <a href={`/products/${heroProduct.slug}`} class="group flex h-12 items-center justify-center rounded-full bg-[#111111] px-8 text-[0.65rem] font-bold uppercase tracking-widest text-white smooth-transition active:scale-[0.98] hover:shadow-2xl hover:shadow-black/20">
          Shop The Drop
          <span class="ml-3 flex h-6 w-6 items-center justify-center rounded-full bg-white/10 smooth-transition group-hover:translate-x-1">→</span>
        </a>

        <div class="flex items-center gap-4 text-[0.65rem] font-bold tracking-widest text-black">
          <span>01</span>
          <span class="w-8 h-[1px] bg-black/30"></span>
          <span>03</span>
          <button type="button" class="ml-4 flex h-8 w-8 items-center justify-center rounded-full border border-black/10 smooth-transition active:scale-[0.98] hover:border-black text-black" aria-label="Previous slide">←</button>
          <button type="button" class="flex h-8 w-8 items-center justify-center rounded-full border border-black/10 smooth-transition active:scale-[0.98] hover:border-black text-black" aria-label="Next slide">→</button>
        </div>
      </div>
    </article>

    <!-- Right Imagery -->
    <div class="relative flex-1 aspect-[4/5] rounded-[2.5rem] bg-[#F5F2EA] overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.05)] transform-gpu flex overflow-x-auto snap-x snap-mandatory hide-scrollbar">
      {heroProduct.images.slice(0, 3).map((img: string, idx: number) => (
        <img src={img} alt={`${heroProduct.title} ${idx + 1}`} class="shrink-0 w-full h-full object-cover object-bottom snap-center" fetchpriority={idx === 0 ? "high" : "auto"} loading={idx === 0 ? "eager" : "lazy"} />
      ))}
    </div>
  </section>
  <style>
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      scrollbar-width: none;
    }
  </style>

  <!-- Categories (Horizontal Row) -->
  <section class="mx-auto mt-12 w-full max-w-7xl px-6">
    <div class="grid grid-cols-4 gap-4">
      {categories.map((category) => (
        <a href={category.href} class="group flex items-center gap-4 rounded-2xl bg-[#F5F5F5] p-3 transition-colors hover:bg-black/5">
          <div class="h-16 w-16 overflow-hidden rounded-xl bg-white shrink-0">
            <img src={category.image} alt={category.label} class="h-full w-full object-cover object-top smooth-transition group-hover:scale-105" loading="lazy" />
          </div>
          <div class="flex flex-col">
            <h3 class="font-editorial text-[0.65rem] font-bold uppercase tracking-widest text-black">{category.label}</h3>
            <span class="font-editorial text-[0.55rem] text-black/50 mt-1">Explore essentials</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Trust Badges (White Cards on Off-White) -->
  <section class="mx-auto mt-6 w-full max-w-7xl px-6">
    <div class="grid grid-cols-4 gap-4">
      <div class="flex flex-col items-center justify-center rounded-2xl border border-black/5 bg-white p-6 text-center shadow-sm">
        <svg class="w-6 h-6 text-black mb-3 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
        <span class="text-[0.55rem] font-bold uppercase tracking-widest text-black leading-tight mb-1.5">Premium Quality</span>
        <span class="text-[0.55rem] font-medium text-black/50">100% Cotton</span>
      </div>
      <div class="flex flex-col items-center justify-center rounded-2xl border border-black/5 bg-white p-6 text-center shadow-sm">
        <svg class="w-6 h-6 text-black mb-3 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M12 12h.01"></path></svg>
        <span class="text-[0.55rem] font-bold uppercase tracking-widest text-black leading-tight mb-1.5">Cash On Delivery</span>
        <span class="text-[0.55rem] font-medium text-black/50">Available For India</span>
      </div>
      <div class="flex flex-col items-center justify-center rounded-2xl border border-black/5 bg-white p-6 text-center shadow-sm">
        <svg class="w-6 h-6 text-black mb-3 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
        <span class="text-[0.55rem] font-bold uppercase tracking-widest text-black leading-tight mb-1.5">Easy Returns</span>
        <span class="text-[0.55rem] font-medium text-black/50">7 Day Policy</span>
      </div>
      <div class="flex flex-col items-center justify-center rounded-2xl border border-black/5 bg-white p-6 text-center shadow-sm">
        <svg class="w-6 h-6 text-black mb-3 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <span class="text-[0.55rem] font-bold uppercase tracking-widest text-black leading-tight mb-1.5">Secure Payments</span>
        <span class="text-[0.55rem] font-medium text-black/50">UPI, Cards & More</span>
      </div>
    </div>
  </section>

  <!-- Latest Drops Grid -->
  <section class="mx-auto my-24 w-full max-w-7xl px-6">
    <div class="mb-10 flex items-end justify-between border-b border-black/5 pb-6">
      <h2 class="heading-condensed text-4xl font-black">Latest Drops</h2>
      <a href="/collections" class="font-editorial text-[0.65rem] font-bold uppercase tracking-widest text-black/50 hover:text-black transition-colors">
        View Full Collection
      </a>
    </div>
    <div class="grid grid-cols-4 gap-x-6 gap-y-12">
      {products.map((product) => (
        <a href={`/products/${product.slug}`} class="group flex flex-col">
          <div class="relative w-full aspect-[4/5] rounded-[1.5rem] overflow-hidden bg-[#F5F5F5] mb-4 shadow-sm border border-black/5">
            <img src={product.images[0]} alt={product.title} class="w-full h-full object-cover object-top smooth-transition group-hover:scale-105" loading="lazy" />
            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm rounded px-2 py-1 text-[0.55rem] font-bold uppercase tracking-widest text-black">
              NEW
            </div>
          </div>
          <h3 class="font-editorial text-[0.7rem] font-bold uppercase tracking-widest text-black mb-1 truncate">{product.title}</h3>
          <div class="flex items-center gap-2">
            <span class="text-sm font-black text-black">{formatInr(product.sellingPrice)}</span>
            {product.mrp > product.sellingPrice && (
              <span class="text-[0.65rem] text-black/40 line-through">{formatInr(product.mrp)}</span>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
</div>
