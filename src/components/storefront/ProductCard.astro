---
import type { DemoProduct } from "@/lib/types";
import { formatInr } from "@/lib/utils";

interface Props {
  product: DemoProduct;
  showBadge?: boolean;
}

const { product, showBadge = true } = Astro.props;
const isDiscounted = product.sellingPrice < product.mrp;
---

<article class="wc-product-card">
  <a href={`/products/${product.slug}`} aria-label={`View ${product.title}`}>
    <div class="wc-product-card__media">
      <img src={product.images[0]} alt={product.title} loading="lazy" />
      {showBadge && product.badge && <span class="wc-product-card__badge">{product.badge}</span>}
      <button type="button" class="wc-product-card__heart" aria-label={`Save ${product.title}`}>♡</button>
    </div>
    <div class="wc-product-card__info">
      <h3>{product.title}</h3>
      <p>
        {formatInr(product.sellingPrice)}
        {isDiscounted && <span>{formatInr(product.mrp)}</span>}
      </p>
      {isDiscounted && <em>sale</em>}
    </div>
  </a>
</article>
