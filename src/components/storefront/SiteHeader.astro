---
import { HeaderAuthCartControls } from "../react/StorefrontClient.tsx";

const navLinks = [
  { href: "/collections/drop-01", label: "new drop" },
  { href: "/collections", label: "shop" },
  { href: "/collections", label: "collections" },
  { href: "/account/wishlist", label: "wishlist" },
];

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
---

<header class="w-full z-50 bg-[#F9F9F9]">
  {isHome && (
    <div class="bg-[#DFFF3F] px-4 py-2 text-center flex items-center justify-center">
      <p class="text-[0.65rem] font-bold uppercase tracking-widest text-black">
        NEW DROP LIVE • FREE SHIPPING ON PREPAID ORDERS
      </p>
    </div>
  )}

  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 border-b border-black/5">
    <a href="/" class="heading-condensed text-4xl font-black tracking-tight text-black" aria-label="WhÿClub home">
      WHŸCLUB
    </a>

    <nav class="hidden items-center gap-9 md:flex" aria-label="Primary navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="font-editorial text-sm font-extrabold uppercase tracking-[0.08em] text-black/70 transition-colors hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-6">
      <HeaderAuthCartControls client:only="react" />
    </div>
  </div>
</header>
