---
import { StorefrontClientBridge } from "../components/react/StorefrontClient.tsx";
import SiteFooter from "@/components/storefront/SiteFooter.astro";
import SiteHeader from "@/components/storefront/SiteHeader.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "WhÿClub demo storefront" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121212" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Instrument+Serif:ital@0;1&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --font-display: "Instrument Serif", serif;
        --font-body: "Inter", sans-serif;
        --font-editorial: "Newsreader", serif;
        --font-mono: "JetBrains Mono", monospace;
      }

      body {
        font-family: var(--font-body);
      }

      .font-display {
        font-family: var(--font-display);
      }
    </style>
  </head>
  <body class="text-neutral-950 antialiased bg-[#F9F9F9]">
    <SiteHeader />
    <div class="relative min-h-screen overflow-x-hidden">
      <!-- Site Content -->
      <main class="relative z-10"><slot /></main>
      <StorefrontClientBridge client:only="react" />
    </div>
    <SiteFooter />
  </body>
</html>
