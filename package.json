{
  "name": "whyclub-ecommerce",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "concurrently \"npm run convex:dev\" \"npm run dev\" --names \"CONVEX,ASTRO\" --prefix-colors \"blue,cyan\" --kill-others-on-fail",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run test && npm run check && npm run build",
    "test:e2e": "playwright test",
    "images:webp": "node scripts/convert-public-images-to-webp.mjs",
    "generate-types": "wrangler types",
    "convex:dev": "convex dev --typecheck=disable",
    "convex:deploy": "convex deploy",
    "convex:codegen": "convex codegen",
    "seed:demo": "node --env-file=.env --import tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.7",
    "@astrojs/react": "^5.0.3",
    "@auth/core": "0.37.4",
    "@convex-dev/auth": "^0.0.92",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.4",
    "clsx": "^2.1.1",
    "convex": "^1.37.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.12.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.2.2",
    "wrangler": "^4.81.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "vite": "^7"
  },
  "optionalDependencies": {
    "@simplewebauthn/server": "^9.0.3",
    "@simplewebauthn/types": "^12.0.0",
    "@types/nodemailer": "^8.0.0",
    "nodemailer": "^6.10.1"
  }
}
